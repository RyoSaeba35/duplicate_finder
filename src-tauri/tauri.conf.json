{
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devPath": "http://localhost:1420",
    "distDir": "../frontend/dist"
  },
  "package": {
    "productName": "Duplicate Finder",
    "version": "0.3.5"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": "^((https?://)|(mailto:)|(tel:)|([a-zA-Z]:\\\\)|(/)).+"
      },
      "dialog": {
        "open": true
      },
      "protocol": {
        "asset": true,
        "assetScope": ["**"]
      },
      "process": {
        "relaunch": true
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/RyoSaeba35/duplicate_finder_releases/main/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzM4REE1OTY5MTA5RjkKUldUNUNaR1dwWTNEYlZ4cTFzZUNJT0x4YU00Ui9UcE9qSE96NjAxWGRtUndRWENyUEVlR2hPbTMK"
    },
    "bundle": {
      "active": true,
      "identifier": "com.yourname.dupfinder",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
      "targets": ["app", "dmg", "msi", "nsis", "updater"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Duplicate Finder",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true
      }
    ]
  }
}
